{
  "title": "Layer 2 — 現状ベース・二軸+5%分析（来客 vs 稼働）",
  "rationale": "絶対ベンチマークではなく、自店現状から『来客+5%』と『稼働率+5pt』の両方を並べ、設備ポテンシャル（MAX）も示す。",
  "utilization_formula": {
    "definition": "ベッド稼働率 ＝ 全施術者の月間施術時間合計 ÷（ベッド数 × 営業時間（分）× 当月日数）× 100",
    "max_potential_sales": "実売上 ÷（稼働率÷100）＝ ベッド・営業時間をフルに使った場合の理論売上（比例試算）",
    "plus_5pt_sales": "実売上 ×（5 ÷ 現在稼働率）※ SETUP.md 準拠・試算と明記",
    "default_hours": "10:00-24:00（14h）※店舗JSONにhoursがあればそちらを使用"
  },
  "dual_axis_concept": {
    "visitor_plus_5pct": "需要側の一歩。集客・リピート・キャンペーン向け",
    "util_plus_5pt": "設備活用の一歩。シフト・予約枠・受け入れ時間向け",
    "max_potential": "天井感の可視化。『まだ○%しか使えていない』を数値で",
    "start_with": "まず稼働率+5ptを目標に掲げつつ、低稼働店は来客施策で席を埋める"
  },
